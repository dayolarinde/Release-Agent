# Slack app config
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_RELEASE_CHANNEL=

# GitHub
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WEBHOOK_SECRET=

# GitHub Copilot SDK (src/ai.js) - token from an account with an active Copilot subscription
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=gpt-5

# Postgres
DATABASE_URL=
# Set to "false" to disable SSL (defaults to enabled with rejectUnauthorized: false)
PGSSL=

# Server
PORT=3000
